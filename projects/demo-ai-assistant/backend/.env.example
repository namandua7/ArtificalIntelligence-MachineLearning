# --- Ollama (local chat + embeddings, no API key needed) ---
# Make sure `ollama serve` is running and both models are pulled:
#   ollama pull llama3.2
#   ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
# nomic-embed-text outputs 768-dim vectors (matches the `chunks.embedding` column).
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Database ---
# Matches docker-compose.yml defaults. Only change if you changed docker-compose.yml.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5433/blogdb

# --- RAG ---
# Cosine similarity (0-1) the best retrieved chunk must reach before the assistant
# answers strictly from blog content. Below this, it answers as a general assistant.
SIMILARITY_THRESHOLD=0.5

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
