# --- LLM provider: "gemini" (free tier, recommended) or "ollama" (fully local) ---
LLM_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model your key can use. Run `python -m app.scripts.check_llm` to list them.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Ollama (embeddings always; chat too when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
# nomic-embed-text outputs 768-dim vectors (matches EMBEDDING_DIM in app/models.py).
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- QueryPilot's own database (docker-compose `app-db`) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5434/querypilot

# --- Encrypts saved connection strings. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# --- Query safety ---
STATEMENT_TIMEOUT_MS=10000
MAX_RESULT_ROWS=1000
# Allow the agent to look at a few sample rows (sent to the LLM). Set false for sensitive data.
ALLOW_SAMPLE_ROWS=true

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3001

# --- Latency (local Ollama) ---
# Keep models loaded between requests; cold-loading costs 5-15 s. num_ctx caps the context window.
OLLAMA_KEEP_ALIVE=2h
# Embedding model on CPU (tiny model; avoids 10-30 s GPU<->CPU reloads and GPU contention)
OLLAMA_EMBED_ON_CPU=true
OLLAMA_NUM_CTX=4096
# Replay identical first-turn questions from memory for this many seconds (0 disables).
ANSWER_CACHE_TTL_S=300
# Load models + pandas at startup so the first question isn't the slow one.
WARMUP_MODELS_ON_START=true

# --- Self-consistency ("Verify") ---
# off by default (free tier). The Verify button turns it on per question; each check costs CONSISTENCY_CANDIDATES extra calls.
SELF_CONSISTENCY=off
CONSISTENCY_CANDIDATES=2

# --- Column value profiling at index time (also needs ALLOW_SAMPLE_ROWS=true) ---
PROFILE_VALUES=true
PROFILE_MAX_COLUMNS=250
PROFILE_MAX_DISTINCT=40

# --- Python analysis sandbox (agent tool run_python) ---
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_S=15
SANDBOX_MEMORY_MB=1024
